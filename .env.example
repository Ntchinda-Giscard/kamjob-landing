# Canonical origin of THIS landing site. Used for canonical URLs, the sitemap,
# robots.txt, Open Graph tags and the JSON-LD structured data — set it in
# production or link previews and search results will point at the default.
NEXT_PUBLIC_SITE_URL=https://kamjob.com

# URL of the deployed candidate app (sign-up / login buttons route there).
NEXT_PUBLIC_APP_URL=https://app.kamjob.com

# URL of the deployed employer portal (the "Espace Employeur" card routes there).
# Leave unset until the employer app is deployed.
NEXT_PUBLIC_EMPLOYER_URL=
